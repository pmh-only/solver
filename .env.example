DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
ADMIN_USER_IDS=your_discord_user_id_here
PORT=3000
WEB_HOST=0.0.0.0
WEB_DOMAIN=https://your-public-service.example
WEB_SESSION_SECRET=generate-a-random-value-with-at-least-32-characters
WEB_ADMIN_BOOTSTRAP_SECRET=generate-a-separate-random-bootstrap-value
WEB_ADMIN_OIDC_SUBJECTS=your-oidc-subject-here
# Set false only for local HTTP development. Production cookies are Secure by default.
WEB_SECURE_COOKIES=true
# Enable only when requests always arrive through a trusted proxy that sets X-Forwarded-For.
WEB_TRUST_PROXY=true
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=you@example.com
IMAP_PASS=your_imap_password_here
IMAP_MAILBOX=INBOX
KV_STORE_PATH=./data/kv.sqlite
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_ADMIN_KEY=sk-admin-your-openai-admin-key-here
FIRECRAWL_API_KEY=fc-your-firecrawl-api-key-here
MAIL_API_KEY=pmail_your_api_key_here
GOOGLE_OAUTH_CREDENTIALS_BASE64=base64-encoded-google-oauth-credentials-json
GOOGLE_CALENDAR_REDIRECT_URI=https://your-public-service.example/mcp/google-calendar/callback
